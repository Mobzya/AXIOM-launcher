{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AXIOM: Build Debug APK",
      "type": "shell",
      "command": "bash",
      "args": ["build-linux.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "AXIOM: Install on Redmi (USB)",
      "type": "shell",
      "command": "adb",
      "args": ["install", "-r", "app/build/outputs/apk/debug/app-debug.apk"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["AXIOM: Build Debug APK"],
      "problemMatcher": []
    },
    {
      "label": "AXIOM: Open launcher",
      "type": "shell",
      "command": "adb",
      "args": ["shell", "am", "start", "-n", "dev.axiom.launcher/.MainActivity"],
      "problemMatcher": []
    },
    {
      "label": "AXIOM: Android crashes log",
      "type": "shell",
      "command": "adb",
      "args": ["logcat", "-s", "AndroidRuntime:E", "AXIOM:D"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "AXIOM: List devices",
      "type": "shell",
      "command": "adb",
      "args": ["devices", "-l"],
      "problemMatcher": []
    }
  ]
}
